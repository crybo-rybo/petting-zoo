{
  "server": {
    "host": "127.0.0.1",
    "port": 8080
  },
  "runtime": {
    "model_discovery_paths": [
      "./uploads/"
    ],
    "memory_db_path": "./uploads/memory.db"
  },
  "mcp_connectors": [
    {
      "id": "fs",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./uploads/"]
    }
  ]
}
